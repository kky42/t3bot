#!/bin/sh
# Phone escalation via Apple Reminders (iCloud → iPhone banner + sound). Mac-iPhone only; other devices unsupported.
#   bin/nudge <title> [lead-minutes]   (lead defaults to 15; iCloud sync needs the head start)
# Opt-in by judgment (bot-nudge SKILL.md): only for urgent, time-critical events. Hard cap: 2 per bot per day.
cd "$(dirname "$0")/.." || exit 1
title="$1"; lead="${2:-15}"
case "$lead" in ''|*[!0-9]*) echo "NUDGE: FAIL - lead must be a number of minutes"; exit 1;; esac
[ "$lead" -ge 3 ] || { echo "NUDGE: FAIL - lead under 3min arrives past due (sync latency); use 15"; exit 1; }
[ -n "$title" ] || { echo "NUDGE: FAIL - usage: bin/nudge <title> [lead-minutes]"; exit 1; }
today=$(date '+%Y-%m-%d')
count=$(awk -v d="$today" '$0 ~ "^- " d " " {c++} END{print c+0}' me/.nudge-log 2>/dev/null)
[ "$count" -ge 2 ] && { echo "NUDGE: FAIL - daily cap (2) reached today; tell the user in-thread instead"; exit 1; }
bot=$(sed -n 's/^- Name: *//p' me/SOUL.md 2>/dev/null | head -1); bot=${bot:-$(basename "$PWD")}
fire=$(date -v+${lead}M '+%Y-%m-%d %H:%M:%S' 2>/dev/null) || { echo "NUDGE: FAIL - BSD date required (macOS)"; exit 1; }
body="Sent by $bot at $(date '+%Y-%m-%d %H:%M:%S')"
id=$(osascript - "$bot" "$title" "$fire" "$body" <<'EOF'
on run argv
  tell application "Reminders"
    make new reminder in list "提醒" with properties {name:(item 1 of argv) & ": " & (item 2 of argv) & " — 收到请回", due date:date (item 3 of argv), body:(item 4 of argv)}
  end tell
end run
EOF
) || { echo "NUDGE: FAIL - osascript error (check Automation permission for the calling app)"; exit 1; }
case "$id" in reminder://*|x-apple-reminder://*) ;; *) echo "NUDGE: FAIL - unexpected osascript output: $id"; exit 1;; esac
echo "- $today $(date '+%H:%M') $title" >> me/.nudge-log
echo "NUDGE: sent ($bot, fires in ${lead}m) $id"
