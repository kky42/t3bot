#!/bin/sh
# Force this bot's code to match its upstream. Edits to tracked files and local commits are discarded;
# untracked and ignored files (me/, my-* skills) are kept. Prints one status line.
cd "$(dirname "$0")/.." || exit 1
git rev-parse '@{u}' >/dev/null 2>&1 || { echo "UPDATE: skipped - no upstream branch"; exit 0; }
git fetch -q || { echo "UPDATE: failed - git fetch"; exit 1; }
old=$(git rev-parse --short HEAD)
new=$(git rev-list --count 'HEAD..@{u}')
local=$(git rev-list --count '@{u}..HEAD')
edited=$(git status --porcelain --untracked-files=no | wc -l | tr -d ' ')
[ "$new$local$edited" = 000 ] && { echo "UPDATE: none"; exit 0; }
git reset -q --hard '@{u}' || { echo "UPDATE: failed - git reset"; exit 1; }
msg="UPDATE: $old -> $(git rev-parse --short HEAD) ($new new commits)"
[ "$local$edited" = 00 ] || msg="$msg; discarded $edited edited files and $local local commits"
echo "$msg - run bin/wake"
